# DAJANA AI – mobilna app (.env)
# Kopiraj: copy .env.example .env  → popuni vrednosti → node scripts/check-env.js --iap

# Supabase (obavezno)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RevenueCat – Project → API keys (obavezno za Shop / IAP)
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_XXXXX
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_XXXXX

# Opciono
EXPO_PUBLIC_R2_PUBLIC_URL=

# Vodič: IAP-NAMESTANJE.md, REVENUECAT-SETUP.md
# EAS production: isti ključevi u EAS Secrets (eas secret:create ...)
